{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/.next",
  "installCommand": "echo 'skipping root install'",
  "framework": "nextjs",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://petrol-dms-backend-production.up.railway.app/api/:path*"
    }
  ]
}
